build/
*.iml

# pubspec.lock IS committed for this app (not a package/plugin) --
# it pins dependency versions for reproducible builds. Don't add a
# blanket *.lock rule here.

# Platform folders are generated by `flutter create .` and are not
# checked in until that step has been run locally.
/android/
/ios/
/linux/
/macos/
/windows/
/web/

.vscode/
.idea/

# Local machine config -- contains your PC's real LAN IP. Copy
# lib/config/network_config.example.dart to network_config.dart and
# fill in your own IP; the real file is never committed.
lib/config/network_config.dart
